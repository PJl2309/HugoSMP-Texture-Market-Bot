<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HugoSMP Texture Market Bot – Nutzungsbedingungen</title>
<style>
  :root{
    --bg: #14141a;
    --surface: #1c1c24;
    --surface-2: #22222c;
    --border: #33333f;
    --text: #e9e7f0;
    --muted: #9b98ab;
    --gold: #e0a83a;
    --gold-soft: #f3cf7a;
    --red: #d5342a;
    --red-soft: #ff6a55;
    --purple: #7a4dc4;
    --purple-soft: #b98cf5;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}

  body{
    margin:0;
    background:
      radial-gradient(ellipse 900px 500px at 12% -10%, rgba(224,168,58,0.12), transparent 60%),
      radial-gradient(ellipse 900px 500px at 88% 8%, rgba(122,77,196,0.12), transparent 60%),
      radial-gradient(ellipse 700px 400px at 50% 100%, rgba(213,52,42,0.06), transparent 60%),
      var(--bg);
    color:var(--text);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }

  .display{
    font-family: 'Rubik', 'Arial Black', sans-serif;
    font-weight:800;
    letter-spacing:0.5px;
  }

  a{color:var(--gold-soft); text-decoration:none;}
  a:hover{text-decoration:underline;}
  a:focus-visible, button:focus-visible{outline:2px solid var(--gold-soft); outline-offset:3px;}

  /* Top bar */
  .topbar{
    position:sticky; top:0; z-index:20;
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 32px;
    background:rgba(20,20,26,0.85);
    backdrop-filter: blur(10px);
    border-bottom:1px solid var(--border);
  }
  .brand{
    display:flex; align-items:center; gap:10px;
    font-size:15px;
  }
  .brand .cube{
    width:14px; height:14px;
    background: linear-gradient(135deg, var(--gold), var(--red));
    border-radius:2px;
    box-shadow: 0 0 10px rgba(224,168,58,0.6);
    flex-shrink:0;
  }
  .brand span{ color: var(--muted); }
  .brand strong{ color: var(--text); }

  .updated-chip{
    display:flex; align-items:center; gap:7px;
    font-size:13px; color:var(--muted);
    border:1px solid var(--border);
    border-radius:999px;
    padding:6px 14px;
  }
  .updated-chip .pulse{
    width:7px; height:7px; border-radius:50%;
    background: var(--gold);
    box-shadow: 0 0 8px var(--gold);
    animation: pulse 2.2s ease-in-out infinite;
  }
  @keyframes pulse{
    0%,100%{ opacity:1; transform:scale(1); }
    50%{ opacity:0.5; transform:scale(0.75); }
  }

  /* Hero */
  .hero{
    max-width:880px; margin:0 auto;
    padding:96px 32px 50px;
    text-align:center;
  }
  .eyebrow{
    display:inline-block;
    font-size:12px; letter-spacing:2px; text-transform:uppercase;
    color:var(--gold-soft);
    background:rgba(224,168,58,0.10);
    border:1px solid rgba(224,168,58,0.35);
    border-radius:999px;
    padding:6px 14px;
    margin-bottom:22px;
  }
  h1.title{
    font-size:clamp(34px, 5vw, 56px);
    margin:0 0 14px;
    line-height:1.1;
  }
  h1.title .gold{ color:var(--gold-soft); }
  h1.title .red{ color:var(--red-soft); }
  h1.title .purple{ color:var(--purple-soft); }

  .hero p.lead{
    color:var(--muted);
    font-size:17px;
    max-width:560px;
    margin:0 auto;
  }

  /* mini pixel grid signature */
  .pixel-signature{
    display:flex; justify-content:center; gap:5px;
    margin:36px 0 4px;
  }
  .pixel-signature span{
    width:9px; height:9px; border-radius:2px;
    opacity:0.85;
    animation: rise 2.6s ease-in-out infinite;
  }
  .pixel-signature span:nth-child(1){ background:var(--gold); animation-delay:0s; }
  .pixel-signature span:nth-child(2){ background:var(--gold-soft); animation-delay:.15s; }
  .pixel-signature span:nth-child(3){ background:var(--red-soft); animation-delay:.3s; }
  .pixel-signature span:nth-child(4){ background:var(--red); animation-delay:.45s; }
  .pixel-signature span:nth-child(5){ background:var(--purple-soft); animation-delay:.6s; }
  .pixel-signature span:nth-child(6){ background:var(--purple); animation-delay:.75s; }
  @keyframes rise{
    0%,100%{ transform:translateY(0); }
    50%{ transform:translateY(-6px); }
  }

  /* On-this-page nav */
  .toc{
    max-width:760px; margin:56px auto 0;
    padding:0 32px;
    display:flex; gap:10px; flex-wrap:wrap; justify-content:center;
  }
  .toc a{
    font-size:13px; color:var(--muted);
    border:1px solid var(--border);
    background:var(--surface);
    border-radius:999px;
    padding:8px 16px;
    display:flex; align-items:center; gap:7px;
    transition: border-color .15s, color .15s, transform .15s;
  }
  .toc a:hover{ border-color:var(--gold); color:var(--gold-soft); transform:translateY(-1px); text-decoration:none; }
  .toc a .n{ font-weight:800; color:var(--gold-soft); }

  main{
    max-width:760px;
    margin:0 auto;
    padding:44px 32px 100px;
  }

  section.doc{ scroll-margin-top: 90px; }

  .rule{
    height:3px; width:64px; border-radius:2px;
    margin: 0 0 40px;
    background:linear-gradient(90deg, var(--gold), var(--red), var(--purple), transparent);
  }

  article.clause{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:14px;
    padding:26px 28px;
    margin-bottom:18px;
    position:relative;
    overflow:hidden;
    transition: border-color .2s, transform .2s;
  }
  article.clause::before{
    content:"";
    position:absolute; left:0; top:0; bottom:0; width:3px;
    background: var(--accent, var(--gold));
  }
  article.clause:hover{
    border-color: color-mix(in srgb, var(--accent, var(--gold)) 45%, var(--border));
    transform: translateY(-2px);
  }

  article.clause h3{
    display:flex; align-items:center; gap:14px;
    font-size:18px;
    margin:0 0 12px;
  }
  article.clause h3 .icon{
    display:inline-flex; align-items:center; justify-content:center;
    width:34px; height:34px;
    border-radius:9px;
    flex-shrink:0;
    background: color-mix(in srgb, var(--accent, var(--gold)) 16%, transparent);
    border:1px solid color-mix(in srgb, var(--accent, var(--gold)) 40%, transparent);
    color: var(--accent, var(--gold-soft));
  }
  article.clause h3 .icon svg{ width:17px; height:17px; }

  article.clause p{
    margin:0 0 10px;
    color:#d6d3e2;
    font-size:15px;
  }
  article.clause p:last-child{ margin-bottom:0; }

  .c-gold{ --accent: var(--gold-soft); }
  .c-red{ --accent: var(--red-soft); }
  .c-purple{ --accent: var(--purple-soft); }

  footer{
    border-top:1px solid var(--border);
    padding:32px;
    text-align:center;
    color:var(--muted);
    font-size:13px;
  }
  footer a{ color:var(--muted); }
  footer a:hover{ color:var(--gold-soft); }

  /* fade-in on load */
  .fade-up{
    opacity:0; transform:translateY(14px);
    animation: fadeUp .6s ease forwards;
  }
  @keyframes fadeUp{ to{ opacity:1; transform:translateY(0); } }

  @media (max-width:640px){
    .topbar{padding:12px 18px; flex-wrap:wrap; gap:8px;}
    .hero{padding:64px 20px 36px;}
    main{padding:30px 18px 80px;}
    article.clause{padding:20px 18px;}
    .toc{padding:0 18px;}
  }

  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    .pixel-signature span, .updated-chip .pulse, .fade-up{ animation:none; opacity:1; transform:none; }
  }

  /* Maus-Licht */
  .cursor-light{
    position:fixed;
    top:0; left:0;
    width:520px; height:520px;
    margin-left:-260px; margin-top:-260px;
    border-radius:50%;
    background: radial-gradient(circle,
      rgba(224,168,58,0.16) 0%,
      rgba(213,52,42,0.09) 35%,
      rgba(122,77,196,0.06) 60%,
      transparent 72%);
    pointer-events:none;
    z-index:1;
    will-change: transform;
    transition: opacity .3s ease;
    opacity:0;
  }
  .cursor-light.active{ opacity:1; }

  /* Treibende Funken */
  .ember{
    position:fixed;
    bottom:-10px;
    width:4px; height:4px;
    border-radius:50%;
    background: var(--gold-soft);
    box-shadow: 0 0 6px 2px rgba(224,168,58,0.7);
    pointer-events:none;
    z-index:0;
    animation: emberRise linear forwards;
  }
  @keyframes emberRise{
    0%{ transform: translateY(0) translateX(0); opacity:0; }
    10%{ opacity:1; }
    90%{ opacity:0.8; }
    100%{ transform: translateY(-110vh) translateX(var(--drift, 40px)); opacity:0; }
  }

  .logo-wrap{
    display:flex; justify-content:center;
    margin-bottom:28px;
  }
  .logo-wrap img{
    width:180px; height:180px;
    border-radius:22px;
    box-shadow:
      0 0 0 1px rgba(224,168,58,0.35),
      0 0 40px rgba(224,168,58,0.25),
      0 0 70px rgba(122,77,196,0.18),
      0 18px 40px rgba(0,0,0,0.45);
    transition: transform .3s ease;
  }
  .logo-wrap img:hover{ transform: scale(1.03) rotate(-1deg); }

  @media (prefers-reduced-motion: reduce){
    .cursor-light{ display:none; }
    .ember{ display:none; }
  }
  @media (max-width:640px){
    .cursor-light{ display:none; }
  }
</style>
</head>
<body>

  <div class="cursor-light" id="cursorLight"></div>

  <div class="topbar" style="position:sticky; z-index:20;">
    <div class="brand">
      <span class="cube"></span>
      <span><strong>HugoSMP</strong> Texture Market Bot</span>
    </div>
    <div class="updated-chip">
      <span class="pulse"></span>
      Letzte Aktualisierung: 29. Juli 2026
    </div>
  </div>

  <section class="hero fade-up" style="position:relative; z-index:2;">
    <div class="logo-wrap">
      <img src="data:image/jpeg;base64," alt="HugoSMP Texture Market Logo">
    </div>
    <span class="eyebrow">Rechtliches</span>
    <h1 class="title display">
      <span class="gold">Nutzungs</span><span class="red">bedingungen</span>
    </h1>
    <p class="lead">Terms of Service für den offiziellen <span style="color:var(--text)">HugoSMP Texture Market Bot</span> – gilt für alle, die den Bot auf Discord nutzen.</p>

    <div class="pixel-signature">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
  </section>

  <nav class="toc fade-up" style="animation-delay:.1s; position:relative; z-index:2;">
    <a href="#zweck"><span class="n">1</span> Zweck des Bots</a>
    <a href="#nutzung"><span class="n">2</span> Nutzung</a>
    <a href="#aenderungen"><span class="n">3</span> Änderungen</a>
    <a href="#haftung"><span class="n">4</span> Haftung</a>
    <a href="#kontakt"><span class="n">5</span> Kontakt</a>
  </nav>

  <main style="position:relative; z-index:2;">
    <section class="doc">
      <div class="rule"></div>

      <article class="clause c-gold fade-up" id="zweck" style="animation-delay:.15s">
        <h3>
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.5 6.5L21 11l-6.5 2.5L12 20l-2.5-6.5L3 11l6.5-2.5z"/></svg></span>
          1. Zweck des Bots
        </h3>
        <p>Der HugoSMP Texture Market Bot wurde ausschließlich zur Verwaltung und Unterstützung des HugoSMP Texture Markets entwickelt. Der Bot dient unter anderem zur Automatisierung von Abläufen, Verwaltung von Funktionen sowie zur Anzeige von Informationen innerhalb des Discord-Servers.</p>
      </article>

      <article class="clause c-gold fade-up" id="nutzung" style="animation-delay:.2s">
        <h3>
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><path d="M8 4v5"/></svg></span>
          2. Nutzung
        </h3>
        <p>Der Bot ist ausschließlich für den vorgesehenen Einsatz bestimmt. Eine öffentliche Bereitstellung oder kommerzielle Nutzung ist nicht vorgesehen.</p>
      </article>

      <article class="clause c-red fade-up" id="aenderungen" style="animation-delay:.25s">
        <h3>
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 11-3.4-7.03"/><path d="M21 3v6h-6"/></svg></span>
          3. Änderungen
        </h3>
        <p>Der Bot und seine Funktionen können jederzeit ohne vorherige Ankündigung geändert, erweitert oder eingestellt werden.</p>
      </article>

      <article class="clause c-red fade-up" id="haftung" style="animation-delay:.3s">
        <h3>
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg></span>
          4. Haftung
        </h3>
        <p>Der Bot wird ohne Garantie auf ständige Verfügbarkeit oder Fehlerfreiheit bereitgestellt. Für Schäden oder Datenverluste, die durch die Nutzung des Bots entstehen, wird keine Haftung übernommen, soweit dies gesetzlich zulässig ist.</p>
      </article>

      <article class="clause c-purple fade-up" id="kontakt" style="animation-delay:.35s">
        <h3>
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg></span>
          5. Kontakt
        </h3>
        <p>Bei Fragen zum Bot kann der Eigentümer des Bots über Discord kontaktiert werden.</p>
      </article>
    </section>
  </main>

  <footer>
    <p>HugoSMP Texture Market Bot &middot; Nutzungsbedingungen</p>
  </footer>

  <script>
    (function(){
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var isTouch = window.matchMedia('(pointer: coarse)').matches;

      // Maus-folgendes Licht
      if(!reduceMotion && !isTouch){
        var light = document.getElementById('cursorLight');
        var raf = null, tx = 0, ty = 0, cx = 0, cy = 0, active = false;

        window.addEventListener('mousemove', function(e){
          tx = e.clientX; ty = e.clientY;
          if(!active){ active = true; light.classList.add('active'); }
          if(!raf){ raf = requestAnimationFrame(update); }
        });

        window.addEventListener('mouseleave', function(){
          light.classList.remove('active');
        });

        function update(){
          cx += (tx - cx) * 0.16;
          cy += (ty - cy) * 0.16;
          light.style.transform = 'translate(' + cx + 'px,' + cy + 'px)';
          if(Math.abs(tx - cx) > 0.3 || Math.abs(ty - cy) > 0.3){
            raf = requestAnimationFrame(update);
          } else {
            raf = null;
          }
        }
      }

      // Aufsteigende Funken
      if(!reduceMotion){
        function spawnEmber(){
          var ember = document.createElement('div');
          ember.className = 'ember';
          var left = Math.random() * 100;
          var duration = 6 + Math.random() * 6;
          var drift = (Math.random() * 80 - 40) + 'px';
          ember.style.left = left + 'vw';
          ember.style.setProperty('--drift', drift);
          ember.style.animationDuration = duration + 's';
          var size = 2 + Math.random() * 3;
          ember.style.width = size + 'px';
          ember.style.height = size + 'px';
          document.body.appendChild(ember);
          setTimeout(function(){ ember.remove(); }, duration * 1000 + 200);
        }
        setInterval(spawnEmber, 500);
        for(var i=0;i<6;i++){ setTimeout(spawnEmber, i * 300); }
      }
    })();
  </script>

</body>
</html>
